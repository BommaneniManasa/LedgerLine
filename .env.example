# LedgerLine - environment variable TEMPLATE.
# Copy to a real file that is NOT committed (see .gitignore), fill in your own values, then load it
# into the shell that starts the backend (see README.md). Nothing here is a real secret.

# --- PostgreSQL (use your own database + user) ---
LEDGERLINE_DB_URL=jdbc:postgresql://localhost:5432/ledgerline
LEDGERLINE_DB_USER=ledgerline_app
LEDGERLINE_DB_PASSWORD=<choose-a-strong-password>

# --- JWT signing secret: at least 32 bytes, random. Generate one with:  openssl rand -base64 48 ---
LEDGERLINE_JWT_SECRET=<generate-a-random-48-byte-secret>

# --- Browser origins allowed to call the API (comma separated, no wildcards) ---
LEDGERLINE_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Optional: creates the FIRST admin on startup if that email does not exist yet.
#     Password needs 10+ chars with a letter and a digit. Remove both lines after the first start. ---
LEDGERLINE_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
LEDGERLINE_BOOTSTRAP_ADMIN_PASSWORD=<choose-a-strong-admin-password>
